# =============================================================================
#  Chandra Surya Roleplay — environment variables
#  Copy to .env.local (development) or set in your host's dashboard (production).
#  NEVER commit real values. Nothing below is ever sent to the browser except
#  variables that start with NEXT_PUBLIC_.
# =============================================================================

# --- Database (PostgreSQL) ----------------------------------------------------
# Without it, development uses an in-memory store (data resets on restart) and
# production returns "service unavailable" for applications/tickets.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/csrp?schema=public"

# --- Auth.js / NextAuth -------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
# Generate with: npx auth secret   (or: openssl rand -base64 32)
NEXTAUTH_SECRET=""
# Auth.js v5 also reads AUTH_SECRET; either one works.
AUTH_SECRET=""

# --- Discord OAuth application (discord.com/developers/applications) ----------
# Redirect URL to register: {NEXTAUTH_URL}/api/auth/callback/discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# --- Discord bot (same application → Bot) -------------------------------------
# Needs to be in your server. Enable the "Server Members Intent".
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""
# Invite code only (the part after discord.gg/) — used to read member counts.
DISCORD_INVITE_CODE="SsFwQaHU"

# --- Discord role IDs (role checks happen server-side via the bot) -------------
DISCORD_WHITELIST_ROLE_ID=""
DISCORD_LSPD_ROLE_ID=""
DISCORD_EMS_ROLE_ID=""
DISCORD_STAFF_ROLE_ID=""
DISCORD_CREATOR_ROLE_ID=""
DISCORD_SUPPORTER_ROLE_ID=""

# --- Website admin access (MANUAL allowlist; Discord roles never grant admin) ---
# OWNER Discord user ID(s): full control, can grant/revoke other admins in /admin/admins.
ADMIN_OWNER_DISCORD_ID=""
# Extra admins: comma-separated "discordId" or "discordId:LEVEL"
# LEVEL = HEAD_ADMIN | ADMIN | MODERATOR | APPLICATION_REVIEWER (default ADMIN)
ADMIN_DISCORD_IDS=""

# --- Whitelist assessment ---------------------------------------------------
# Minutes a player must wait after failing the rule quiz (0 = retry immediately)
WHITELIST_RETRY_COOLDOWN_MINUTES="60"

# --- Browser push notifications (optional, Web Push / VAPID) ----------------
# Generate once with: npx web-push generate-vapid-keys
# The PUBLIC key is sent to browsers; the PRIVATE key must stay secret.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# --- Discord log channel IDs (the bot posts embeds here) ----------------------
APPLICATION_LOG_CHANNEL_ID=""
AUTH_LOG_CHANNEL_ID=""
SUPPORT_LOG_CHANNEL_ID=""
STAFF_LOG_CHANNEL_ID=""
REPORT_LOG_CHANNEL_ID=""
SECURITY_LOG_CHANNEL_ID=""
WHITELIST_LOG_CHANNEL_ID=""
STORE_LOG_CHANNEL_ID=""

# --- Developer cards (manually chosen Discord user IDs, comma-separated) -------
# NOT role-based. Titles/skills live in src/config/server.config.ts.
DEVELOPER_DISCORD_IDS=""

# --- FiveM server -------------------------------------------------------------
FIVEM_SERVER_IP=""
FIVEM_SERVER_PORT="30120"
# Show player names from players.json on the site (privacy: off by default)
FIVEM_EXPOSE_PLAYER_NAMES="false"

# --- Playtime integration (optional HTTP endpoint from your game server) ------
# Must return: { weeklyHours, averageSessionMinutes, peakPlayers, daily: [{t, v}] }
PLAYTIME_API_URL=""
PLAYTIME_API_KEY=""

# --- Status history snapshots -------------------------------------------------
# Call GET /api/cron/snapshot every 5 min with "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=""

# --- Public links (safe for the browser) --------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_DISCORD_INVITE_URL="https://discord.gg/SsFwQaHU"
# fivem://connect/IP:PORT or https://cfx.re/join/XXXXXX (empty → ENTER THE CITY goes to whitelist)
NEXT_PUBLIC_FIVEM_CONNECT_URL=""
NEXT_PUBLIC_YOUTUBE_URL=""
NEXT_PUBLIC_TIKTOK_URL=""
NEXT_PUBLIC_KICK_URL=""
NEXT_PUBLIC_TWITCH_URL=""

# --- Development helpers ------------------------------------------------------
# Demo data: OFF by default. Set "true" in development only to preview the UI
# with sample numbers. Ignored in production — real data or an empty state.
CSRP_MOCK_MODE=""
# Local "Development login" when Discord OAuth isn't configured (never in production)
AUTH_DEV_LOGIN="true"
# Display-only Discord roles for dev users (whitelist,lspd,ems,staff,creator,supporter). Never grants admin.
AUTH_DEV_ROLES=""
# Dev users: 000000000000000001 (Dev Player) and 000000000000000002 (Test Citizen).
# To test /admin locally, set ADMIN_OWNER_DISCORD_ID="000000000000000001" in .env.local.
